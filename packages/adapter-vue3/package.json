{
  "name": "@i18n-tool/adapter-vue3",
  "version": "0.3.0",
  "description": "Vue 3 适配器 — AST 解析、代码替换、响应式检测",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@babel/parser": "^7.24.0",
    "@babel/traverse": "^7.24.0",
    "@i18n-tool/core": "workspace:*",
    "@vue/compiler-sfc": "^3.4.0",
    "jscodeshift": "^0.15.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
